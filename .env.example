# Settings for a source run (npm run dev, npm start). Copy to .env and fill in.
# An installed Lookstow keeps these in server.env in its data folder
# (/var/lib/lookstow or C:\ProgramData\Lookstow), written by the installer.
# Lookstow's own settings live in its database and are changed in the console.

# Path to the SQLite database file.
DATABASE_PATH=./data/lookstow.db
# 32 random bytes in base64: openssl rand -base64 32
SECRETS_KEY=

# Where `npm start` listens (npm run dev uses Vite's port instead).
# The console is for this computer only: keep HOST on 127.0.0.1.
# HOST=127.0.0.1
# PORT=8030

# Launcher-owned values. Source runs leave these unset. An installed server's
# launcher sets installed, its data folder (where the app asks the updater for
# an update and reads its progress), its target and a readiness nonce.
# LOOKSTOW_DEPLOYMENT=source
# LOOKSTOW_UPDATE_DATA=
# LOOKSTOW_LAUNCHER_TARGET=
# LOOKSTOW_READINESS_NONCE=
