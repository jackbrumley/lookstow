{
	"name": "lookstow",
	"version": "0.13.2",
	"private": true,
	"description": "Back up Microsoft 365 mailboxes, shared mailboxes and online archives to a local folder, as a self-updating service for Windows and Linux.",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*",
		"#tests/*": "./tests/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node server.ts",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && npm run check:types",
		"check:types": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "eslint .",
		"fmt": "prettier --write .",
		"fmt:check": "prettier --check .",
		"test": "vitest run",
		"hygiene": "node scripts/hygiene.ts",
		"knip": "knip --no-progress",
		"verify": "svelte-kit sync && run-p --print-label fmt:check lint check:types test hygiene knip && npm run build",
		"db:generate": "drizzle-kit generate",
		"release:local": "node scripts/release-server.ts",
		"release:sign": "node scripts/server-update-sign.ts",
		"release:key": "node scripts/release-key.ts",
		"release:notes": "node scripts/release-notes.ts",
		"release:check": "node scripts/release-check.ts",
		"release:update-test": "node scripts/server-update-scratch-test.ts"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@sveltejs/adapter-node": "6.0.1",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tabler/icons-svelte-runes": "3.49.0",
		"@types/better-sqlite3": "9.6.0",
		"@types/node": "26.6.5",
		"drizzle-kit": "0.31.11",
		"drizzle-orm": "0.45.4",
		"eslint": "10.13.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.13.0",
		"knip": "6.45.1",
		"npm-run-all2": "9.0.4",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.7",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.0",
		"vite": "8.3.6",
		"vitest": "5.0.5",
		"zod": "4.6.7"
	},
	"dependencies": {
		"better-sqlite3": "13.0.3"
	},
	"license": "AGPL-3.0-only",
	"engines": {
		"node": ">=26"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"esbuild@0.18.20": true,
		"esbuild@0.25.12": true
	}
}
